{
  "name": "alian-structure-api",
  "version": "0.1.0",
  "description": "Off-chain services + API layer for alian-structure agents",
  "author": "alian-structure",
  "private": true,
  "license": "Apache-2.0",
  "scripts": {
    "prebuild": "rimraf dist",
    "build:tsc": "tsc -p tsconfig.build.json",
    "build:plain-tsc": "tsc --project tsconfig.json --pretty --listEmittedFiles",
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main.js",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "jest",
    "test:kyc-guard-scan": "node scripts/check-kyc-guard-coverage.js",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "security:audit": "npm audit --audit-level=moderate",
    "security:audit:fix": "npm audit fix",
    "security:generate-secrets": "./scripts/generate-secrets.sh",
    "security:check": "npm run security:audit && npm run lint && npm run test:kyc-guard-scan",
    "build:prod": "nest build --webpack",
    "typeorm": "typeorm-ts-node-commonjs",
    "migration:generate": "npm run typeorm -- migration:generate -d src/config/typeorm.config.ts src/migrations/AuditEntities",
    "migration:run": "npm run typeorm -- migration:run -d src/config/typeorm.config.ts",
    "migration:revert": "npm run typeorm -- migration:revert -d src/config/typeorm.config.ts",
    "seed:audit": "ts-node src/seeds/seed-audit-data.ts",
    "docs:generate": "nest start --watch",
    "docs:serve": "nest start",
    "docs:build": "nest build && node dist/main.js",
    "graphql:codegen": "graphql-codegen --config codegen.ts && prettier --write --ignore-path /dev/null src/graphql/client/generated.ts",
    "openapi:export": "cross-env NODE_ENV=development ts-node -r tsconfig-paths/register scripts/export-openapi.ts",
    "openapi:validate": "ts-node -r tsconfig-paths/register scripts/validate-openapi.ts",
    "openapi:client": "npm run openapi:export && npx @openapitools/openapi-generator-cli generate -i docs/openapi.json -g typescript-fetch -o sdks/typescript --additional-properties=supportsES6=true,typescriptThreePlus=true",
    "openapi:client:python": "npm run openapi:export && npx @openapitools/openapi-generator-cli generate -i docs/openapi.json -g python -o sdks/python --additional-properties=packageName=alian_structure_api,packageVersion=$(npm run -s get-version 2>/dev/null || echo '0.1.0')",
    "openapi:client:all": "npm run openapi:client && npm run openapi:client:python",
    "get-version": "node -p \"require('./package.json').version\"",
    "module:example:register": "node modules/example-grant-module/register.cjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1115.0",
    "@aws-sdk/s3-request-presigner": "^3.1115.0",
    "@azure/storage-blob": "12.32.0",
    "@elastic/elasticsearch": "^9.4.2",
    "@graphql-typed-document-node/core": "^3.2.0",
    "@nestjs/axios": "^4.0.1",
    "@nestjs/bull": "^11.0.4",
    "@nestjs/config": "^3.1.1",
    "@nestjs/core": "^10.3.0",
    "@nestjs/cqrs": "^11.0.3",
    "@nestjs/event-emitter": "^3.0.1",
    "@nestjs/mapped-types": "*",
    "@nestjs/passport": "^10.0.3",
    "@nestjs/platform-express": "^10.3.0",
    "@nestjs/platform-socket.io": "^10.4.22",
    "@nestjs/schedule": "^6.1.3",
    "@nestjs/swagger": "^7.4.2",
    "@nestjs/terminus": "^11.1.1",
    "@nestjs/throttler": "^6.5.0",
    "@nestjs/typeorm": "^10.0.1",
    "@nestjs/websockets": "^10.4.22",
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/auto-instrumentations-node": "^0.69.0",
    "@opentelemetry/exporter-jaeger": "^2.5.1",
    "@opentelemetry/exporter-trace-otlp-http": "^0.211.0",
    "@opentelemetry/resources": "^2.5.0",
    "@opentelemetry/sdk-node": "^0.211.0",
    "@opentelemetry/sdk-trace-base": "^2.5.0",
    "@sentry/nestjs": "^10.59.0",
    "@sentry/node": "^8.4.0",
    "@stellar/stellar-sdk": "^17.0.0",
    "@types/bcrypt": "^6.0.0",
    "@types/multer": "^2.1.0",
    "@types/qrcode": "^1.5.6",
    "@types/speakeasy": "^2.0.10",
    "@willsoto/nestjs-prometheus": "^6.0.2",
    "axios": "^1.13.4",
    "bcrypt": "^6.0.0",
    "bull": "^4.16.5",
    "class-sanitizer": "^1.0.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.0",
    "crypto": "^1.0.1",
    "dataloader": "^2.2.3",
    "dotenv": "^16.3.1",
    "ethers": "^6.10.0",
    "express": "^5.2.1",
    "express-mongo-sanitize": "^2.2.0",
    "express-rate-limit": "^8.2.1",
    "graphql": "^16.14.2",
    "helmet": "^8.1.0",
    "hpp": "^0.2.3",
    "ioredis": "^5.9.3",
    "jsonwebtoken": "^9",
    "multer": "^2.1.1",
    "nodemailer": "^6.9.8",
    "openai": "^6.16.0",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "path": "^0.12.7",
    "pino": "^10.3.0",
    "prom-client": "^15.1.3",
    "qrcode": "^1.5.4",
    "reflect-metadata": "^0.1.13",
    "rimraf": "^5.0.5",
    "rxjs": "^7.8.1",
    "semver": "^7.8.5",
    "serve-favicon": "^2.5.1",
    "sharp": "^0.35.3",
    "socket.io": "^4.8.3",
    "speakeasy": "^2.0.0",
    "swagger-ui-express": "^5.0.1",
    "toidentifier": "^1.0.1",
    "typeorm": "^0.3.19",
    "uuid": "^9.0.1",
    "winston": "^3.19.0",
    "winston-cloudwatch": "^6.3.0",
    "winston-daily-rotate-file": "^5.0.0",
    "winston-transport": "^4.9.0"
  },
  "devDependencies": {
    "@graphql-codegen/cli": "^7.2.0",
    "@graphql-codegen/typed-document-node": "^7.1.0",
    "@graphql-codegen/typescript": "^6.1.0",
    "@graphql-codegen/typescript-operations": "^6.1.6",
    "@nestjs/cli": "^10.3.2",
    "@nestjs/common": "^10.4.22",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/schematics": "^10.0.3",
    "@nestjs/testing": "^10.4.22",
    "@sentry/types": "^10.59.0",
    "@types/bull": "^3.15.9",
    "@types/express": "^4.17.25",
    "@types/jest": "^29.5.14",
    "@types/node": "^26.2.0",
    "@types/nodemailer": "^6.4.14",
    "@types/passport-jwt": "^3.0.8",
    "@types/semver": "7.7.1",
    "@types/serve-favicon": "^2.5.7",
    "@types/socket.io": "^3.0.1",
    "@types/socket.io-client": "^1.4.36",
    "@types/supertest": "^7.2.1",
    "@types/uuid": "^9.0.7",
    "@typescript-eslint/eslint-plugin": "^6.17.0",
    "@typescript-eslint/parser": "^6.17.0",
    "cross-env": "^7.0.3",
    "eslint": "^8.56.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-prettier": "^5.1.2",
    "jest": "^29.7.0",
    "nodemon": "^3.1.11",
    "pg": "^8.22.0",
    "pino-pretty": "^13.1.3",
    "prettier": "^3.1.1",
    "socket.io-client": "^4.8.3",
    "sqlite3": "^5.1.6",
    "supertest": "^6.3.3",
    "ts-jest": "^29.4.6",
    "ts-loader": "^9.5.1",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.9.3"
  }
}
