        "orientation": "auto",
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "100 * sum(rate(alian_structure_rate_limit_denied_total{job=\"$job\"}[5m])) / clamp_min(sum(rate(alian_structure_rate_limit_allowed_total{job=\"$job\"}[5m]) + rate(alian_structure_rate_limit_denied_total{job=\"$job\"}[5m])), 0.001)",
          "legendFormat": "denial rate",
          "refId": "A"
        }
      ]
    },
